# 服务器配置
NODE_ENV=development
PORT=8080

# JWT 配置
# v4 §11.1：JWT_SECRET 必须 ≥ 32 字节（256 bit）
# 开发环境使用固定值便于调试；生产环境务必通过 openssl rand -hex 32 生成
JWT_SECRET=dev-secret-key-please-replace-with-32-bytes-hex-or-more
JWT_ACCESS_EXPIRATION=900
JWT_REFRESH_EXPIRATION=604800

# CORS 配置（v4 fail-fast：非空 + 形如 https?://host[:port]）
ALLOWED_ORIGINS=http://localhost:53000,http://localhost:3000

# Cookie 配置（生产必须 true）
COOKIE_SECURE=false

# 限流配置
RATE_LIMIT_REGISTER_IP=20
RATE_LIMIT_REGISTER_EMAIL=5
RATE_LIMIT_LOGIN_IP=60
RATE_LIMIT_REFRESH_TOKEN=10

# 账户锁定（US-002 登录用）
ACCOUNT_LOCK_THRESHOLD=5
ACCOUNT_LOCK_DURATION_MIN=15

# 幂等键 TTL（毫秒，默认 5min）
IDEMPOTENCY_WINDOW_MS=300000

# 日志
LOG_LEVEL=debug
