#!/bin/sh
# Block direct push to main — all code changes must go through PR.
#
# Install: cp .claude/hooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push

remote="$1"
url="$2"

while read local_ref local_sha remote_ref remote_sha; do
  if [ "$local_ref" = "refs/heads/main" ]; then
    echo ""
    echo "❌ Direct push to main is blocked."
    echo ""
    echo "   All code changes must go through a Pull Request."
    echo ""
    echo "   To push your branch and open a PR:"
    echo "     git push origin <branch-name>"
    echo "     gh pr create"
    echo ""
    exit 1
  fi
done

exit 0
